---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import HubLinks from '../../components/HubLinks.astro';
import site from '../../content/site.json';
import { services, getPricing } from '../../lib/services';
import vanPhoto from '../../assets/images/Various/ff-van-driver-side-long.jpg';

const title = `Carpet, Upholstery & Tile Cleaning Services | ${site.name}, Winona, MN`;
const description =
  'Carpet, upholstery, area rug, tile & grout, and pet odor cleaning around Winona, MN: one person, one truck, published pricing.';
---

<Base title={title} description={description} heroFlush>
  <Fragment slot="hero">
    <Breadcrumb theme="onNavy" items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />
    <div class="hero-copy">
      <div class="eyebrow accent-on-navy">What I do</div>
      <h1>One person, one truck, <span class="accent accent-on-navy">done right.</span></h1>
      <p class="lead">No rotating crews, no upsells, just an honest job, priced upfront.</p>
      <div class="cta-row">
        <a href="/estimate" class="btn btn-azure">Free estimate</a>
        <a href={`tel:${site.phoneTel}`} class="btn btn-tertiary">Call Now</a>
      </div>
    </div>
    <div class="hero-photo-shape">
      <Image src={vanPhoto} alt={`The ${site.name} van`} width={1000} height={750} loading="eager" fetchpriority="high" />
    </div>
  </Fragment>

  <section class="container cards-section">
    <div class="cards-grid">
      {services.map((service) => {
        const pricing = getPricing(service.pricingFile);
        const firstPrice = pricing.rows.find((r) => r.price !== null)?.price ?? 0;
        return (
          <ServiceCard
            href={`/services/${service.route}`}
            slug={service.slug}
            title={service.navLabel}
            description={service.cardDescription}
            photoLabel={service.photoLabel}
            priceLabel={service.cardPriceLabel}
            price={firstPrice}
            unit={service.cardUnit}
          />
        );
      })}
    </div>
  </section>

  <section class="how-it-works">
    <div class="container">
      <h2>How it works</h2>
      <div class="steps">
        <div>
          <div class="step-number">1</div>
          <div class="step-title">Tell me what you need</div>
          <p>Reach out online, or call and text me a couple photos. I'll give you an honest estimate: free, no pressure.</p>
        </div>
        <div>
          <div class="step-number">2</div>
          <div class="step-title">I show up on time</div>
          <p>You'll get a specific arrival window, not an all-day wait. I confirm the estimate before I start any work.</p>
        </div>
        <div>
          <div class="step-number">3</div>
          <div class="step-title">You're covered {site.guaranteeDays} days</div>
          <p>Not right within {site.guaranteeDays} days? I'll come back and re-clean the area, no charge, no hassle.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container hub-links-section">
    <HubLinks current="services" />
  </section>
</Base>

<style>
  .hero-copy {
    position: relative;
    z-index: 1;
    padding: 28px 0 48px;
  }

  @media (min-width: 861px) {
    .hero-copy {
      max-width: 540px;
      padding: 56px 0;
    }
  }

  .hero-copy h1 {
    color: var(--ff-on-navy);
    font-size: var(--ff-size-h1);
    line-height: 1.03;
    margin: 18px 0 24px;
    letter-spacing: var(--ff-tracking-display);
  }

  .cta-row {
    display: flex;
    gap: 18px;
    align-items: center;
  }

  .lead {
    font-size: var(--ff-size-body);
    line-height: 1.6;
    color: var(--ff-on-navy-soft);
    margin: 0 0 18px;
  }

  @media (max-width: 640px) {
    .hero-copy h1 {
      font-size: 40px;
    }
  }

  .cards-section {
    padding: 64px var(--ff-gutter) 24px;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 900px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }

  .how-it-works {
    background: var(--ff-band-blue);
    padding: 72px 0;
  }

  .how-it-works h2 {
    font-size: var(--ff-size-h2);
    margin-bottom: 40px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  @media (max-width: 700px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  .step-number {
    font-family: var(--ff-font-display);
    font-weight: var(--ff-weight-semibold);
    font-size: 38px;
    color: var(--ff-azure);
    margin-bottom: 10px;
  }

  .step-title {
    font-weight: var(--ff-weight-bold);
    color: var(--ff-text);
    font-size: var(--ff-size-body-lg);
    margin-bottom: 6px;
  }

  .steps p {
    font-size: var(--ff-size-body);
    line-height: 1.6;
    color: var(--ff-text-muted);
    margin: 0;
  }

  .hub-links-section {
    padding: 40px var(--ff-gutter) 80px;
  }
</style>
