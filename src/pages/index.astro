---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ServicePhoto from '../components/ServicePhoto.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import ReviewCard from '../components/ReviewCard.astro';
import Callout from '../components/Callout.astro';
import site from '../content/site.json';
import { getReviews } from '../lib/reviews';
import { services } from '../lib/services';
import { servicePhotos } from '../lib/photos';
import heroPhoto from '../assets/images/Various/ff-van-driver-side-rear.jpg';
import augieVan from '../assets/images/Various/augie_van.jpeg';

const carpetPhotos = servicePhotos.carpet;

const title = `Carpet & Upholstery Cleaning | ${site.name}`;
const description = `Owner-operated carpet, rug, and upholstery cleaning for homes around Winona, MN and La Crosse, WI. Published pricing, free estimates, and a ${site.guaranteeDays}-day guarantee.`;

const avatarColors = ['var(--ff-navy-cta)', 'var(--ff-azure)', 'var(--ff-accent-on-navy)'];

// Built into the static page at deploy time; the /reviews page is live.
const reviewsData = await getReviews();
const homeReviews = reviewsData?.reviews.slice(0, 3) ?? [];
---

<Base title={title} description={description} heroFlush>
  <Fragment slot="hero">
    <div class="hero-copy">
      <div class="eyebrow accent-on-navy">Carpet &amp; upholstery cleaning</div>
      <h1>Cleaner carpets, <span class="accent accent-on-navy">done right.</span></h1>
      <p class="lead">
        I'm {site.ownerName}, cleaning homes around{' '}
        <span class="location-carousel">
          <span class="location-sizer" aria-hidden="true">
            {site.serviceAreas.map((area) => (
              <span class="sizer-item">{area}</span>
            ))}
          </span>
          {site.serviceAreas.map((area, i) => (
            <span class:list={['location-item', { 'is-active': i === 0 }]}>{area}</span>
          ))}
        </span>
      </p>
      <div class="cta-row">
        <a href="/estimate" class="btn btn-azure">Free estimate</a>
        <a href={`tel:${site.phoneTel}`} class="btn btn-tertiary">Call Now</a>
      </div>
    </div>
    <div class="hero-photo-shape">
      <Image src={heroPhoto} alt={`The ${site.name} van`} width={1080} height={864} fit="cover" widths={[540, 720, 1080, 1440, 1800, 2160]} sizes="(min-width: 861px) 54vw, 100vw" loading="eager" fetchpriority="high" />
    </div>
  </Fragment>

  <section class="container services-section">
    <div class="section-head">
      <div>
        <h2>What I clean</h2>
        <p>Everything gets the same careful, hand-done treatment.</p>
      </div>
      <a href="/services" class="btn btn-tertiary">See all services <span class="arrow">→</span></a>
    </div>
    <div class="services-grid">
      {services.map((service) => (
        <a href={`/services/${service.route}`} class="service-tile">
          <ServicePhoto
            slug={service.slug}
            variant="homeTile"
            label={service.photoLabel}
            alt={`${service.navLabel} in the Driftless Region`}
            dimensions="600 × 400px"
            aspectRatio="3 / 2"
            rounded={false}
          />
          <div class="tile-body">
            <div class="tile-title">{service.navLabel}</div>
            <p>{service.homeDescription}</p>
            <span class="see-details">See details <span class="arrow">→</span></span>
          </div>
        </a>
      ))}
    </div>
    <Callout>
      <span class="not-sure-text">Tell me what you need and I'll help you figure it out.</span>
      <div slot="action" class="not-sure-actions">
        <a href="/estimate" class="btn btn-primary">Free estimate</a>
        <a href={`tel:${site.phoneTel}`} class="btn btn-tertiary">Call {site.phone}</a>
      </div>
    </Callout>
  </section>

  <section class="container how-section">
    <h2>How it works</h2>
    <p class="how-lead">Three easy steps. No sales pitch, no surprises.</p>
    <div class="steps">
      <div class="step-card">
        <div class="step-number">1</div>
        <div class="step-title">Reach out</div>
        <p>Reach out online, or give me a call or text. Tell me a bit about what needs cleaning.</p>
      </div>
      <div class="step-card">
        <div class="step-number">2</div>
        <div class="step-title">I confirm your time</div>
        <p>I'll reach back out to lock in a time that works, and give you a quote.</p>
      </div>
      <div class="step-card">
        <div class="step-number">3</div>
        <div class="step-title">I clean, you relax</div>
        <p>I show up and don't leave until you're happy with the job.</p>
      </div>
    </div>
  </section>

  <section class="about-band">
    <div class="container about-inner">
      <Image src={augieVan} alt={`${site.ownerName} with the Fresh Fibers van`} class="about-photo" width={640} height={640} />
      <div>
        <h2 class="on-navy">One local, doing it right.</h2>
        <p class="on-navy-body">
          {site.name} is me, {site.ownerName}. I got into this because I like helping people out, and I
          run this the way you'd want a neighbor to: show up when I say I will, treat your home with
          care, and don't leave until you're happy with it.
        </p>
        <p class="on-navy-body">
          One person, and I stand behind every job. If something's not right, I'll come back and make
          it right.
        </p>
        <a href="/about" class="on-navy-link">More about {site.name} <span class="accent-on-navy">→</span></a>
      </div>
    </div>
  </section>

  <section class="container ba-section">
    <div class="section-head">
      <div>
        <h2>Before &amp; after</h2>
        <p>Drag the slider to compare. Jobs from Winona to La Crosse.</p>
      </div>
      <a href="/work" class="btn btn-tertiary">See more work <span class="arrow">→</span></a>
    </div>
    <BeforeAfterSlider
      beforeImage={carpetPhotos.before}
      afterImage={carpetPhotos.after}
      beforePosition={carpetPhotos.beforePosition}
      afterPosition={carpetPhotos.afterPosition}
      beforeLabel="BEFORE · Carpet cleaning"
      afterLabel="AFTER · Carpet cleaning"
      alt="carpet cleaning"
    />
  </section>

  <section class="reviews-band">
    <div class="container">
      <div class="reviews-layout">
        <div class="reviews-head">
          <div class="reviews-title-block">
            <svg width="34" height="34" viewBox="0 0 48 48" aria-hidden="true">
              <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
              <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
              <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
              <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
            </svg>
            <div>
              <div class="reviews-title">Google reviews</div>
              <div class="reviews-sub">From neighbors across the region</div>
            </div>
          </div>
          {reviewsData && (
            <div class="rating-block">
              <span class="rating-number">{reviewsData.aggregateRating.toFixed(1)}</span>
              <div class="stars">★★★★★</div>
            </div>
          )}
        </div>
        {!reviewsData || homeReviews.length === 0 ? (
          <p class="reviews-coming-soon">We're just getting started! Check back soon for feedback from jobs around the area.</p>
        ) : (
          <>
            <a href="/reviews" class="btn btn-tertiary see-all-reviews">See all reviews <span class="arrow">→</span></a>
            <div class="review-cards">
              {homeReviews.map((review, i) => (
                <ReviewCard name={review.name} when={review.when} rating={review.rating} text={review.text} photoUrl={review.photoUrl} href={review.href} avatarColor={avatarColors[i % avatarColors.length]} />
              ))}
            </div>
          </>
        )}
      </div>
    </div>
  </section>

</Base>

<script>
  const carousel = document.querySelector('.location-carousel');
  const items = carousel ? carousel.querySelectorAll('.location-item') : null;

  if (carousel && items && items.length > 1) {
    carousel.style.width = `${items[0].offsetWidth}px`;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) {
      let current = 0;
      setInterval(() => {
        const next = (current + 1) % items.length;
        carousel.style.width = `${items[next].offsetWidth}px`;
        items[current].classList.remove('is-active');
        items[next].classList.add('is-active');
        current = next;
      }, 3200);
    }
  }
</script>

<style>
  .hero-copy {
    position: relative;
    z-index: 1;
    padding: 28px 0 0;
  }

  @media (min-width: 861px) {
    .hero-copy {
      max-width: 540px;
      padding: 72px 0;
    }
  }

  .hero-copy h1 {
    color: var(--ff-on-navy);
    font-size: 64px;
    line-height: 1.02;
    margin: 18px 0 24px;
    letter-spacing: var(--ff-tracking-display);
  }

  @media (max-width: 860px) {
    .hero-copy h1 {
      font-size: 40px;
    }
  }

  .lead {
    font-size: var(--ff-size-body);
    line-height: 1.6;
    color: var(--ff-on-navy-soft);
    margin: 0 0 22px;
    max-width: 400px;
  }

  .cta-row {
    display: flex;
    gap: 18px;
    align-items: center;
    flex-wrap: wrap;
  }

  .location-carousel {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
    overflow: visible;
    clip-path: inset(0);
    transition: width 0.4s ease;
  }

  .location-sizer {
    display: inline-grid;
    visibility: hidden;
  }

  .sizer-item {
    grid-area: 1 / 1;
    white-space: nowrap;
    font-weight: var(--ff-weight-semibold);
  }

  .location-item {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    white-space: nowrap;
    color: var(--ff-accent-on-navy);
    font-weight: var(--ff-weight-semibold);
    transition: opacity 0.4s ease;
  }

  .location-item.is-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .location-carousel {
      transition: none;
    }

    .location-item {
      transition: none;
    }
  }

  .services-section {
    padding: 80px var(--ff-gutter) 40px;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 36px;
    gap: 24px;
    flex-wrap: wrap;
  }

  .section-head h2 {
    font-size: var(--ff-size-h2);
    margin-bottom: 8px;
  }

  .section-head p {
    font-size: var(--ff-size-body-lg);
    color: var(--ff-text-muted);
    margin: 0;
  }

  .arrow {
    color: var(--ff-azure);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 32px;
  }

  @media (max-width: 780px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  .service-tile {
    display: flex;
    flex-direction: column;
    background: var(--ff-surface);
    border-radius: var(--ff-radius-card);
    box-shadow: var(--ff-shadow-card);
    overflow: hidden;
    text-decoration: none;
    transition: box-shadow var(--ff-transition), transform var(--ff-transition);
  }

  .service-tile:hover {
    box-shadow: var(--ff-shadow-hover);
  }

  @media (hover: hover) {
    .service-tile:hover {
      transform: translateY(var(--ff-lift-hover));
    }
  }

  .tile-body {
    padding: 24px 30px 30px;
  }

  .tile-title {
    font-size: 21px;
    font-weight: var(--ff-weight-bold);
    color: var(--ff-text);
    margin-bottom: 8px;
  }

  .service-tile p {
    font-size: var(--ff-size-body-sm);
    line-height: 1.6;
    color: var(--ff-text-muted);
    margin: 0 0 18px;
  }

  .see-details {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--ff-size-body-sm);
    font-weight: var(--ff-weight-semibold);
    color: var(--ff-azure);
  }

  .not-sure-text {
    font-size: var(--ff-size-lead);
    color: var(--ff-text);
    font-weight: var(--ff-weight-semibold);
  }

  .not-sure-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
  }

  @media (max-width: 480px) {
    .not-sure-actions {
      width: 100%;
    }

    .not-sure-actions .btn {
      width: 100%;
    }
  }

  .how-section {
    padding: 40px var(--ff-gutter) 80px;
  }

  .how-section h2 {
    font-size: var(--ff-size-h2);
    margin-bottom: 8px;
  }

  .how-lead {
    font-size: var(--ff-size-body-lg);
    color: var(--ff-text-muted);
    margin: 0 0 40px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  @media (max-width: 700px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  .step-card {
    /* Resting elevation only — these aren't links, so no hover state:
       a lift-on-hover here would read as a click affordance that
       doesn't exist. */
    background: var(--ff-surface);
    border-radius: var(--ff-radius-card);
    box-shadow: var(--ff-shadow-card);
    padding: 32px 28px;
  }

  .step-number {
    font-family: var(--ff-font-display);
    font-weight: var(--ff-weight-semibold);
    font-size: 38px;
    color: var(--ff-azure);
    line-height: 1;
    margin-bottom: 16px;
  }

  .step-title {
    font-size: 21px;
    font-weight: var(--ff-weight-bold);
    color: var(--ff-text);
    margin-bottom: 8px;
  }

  .steps p {
    font-size: var(--ff-size-body);
    line-height: 1.6;
    color: var(--ff-text-muted);
    margin: 0;
  }

  .about-band {
    background: var(--ff-navy);
  }

  .about-inner {
    padding: 80px var(--ff-gutter);
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--ff-gap-lg);
    align-items: center;
  }

  @media (max-width: 780px) {
    .about-inner {
      grid-template-columns: 1fr;
    }
  }

  .about-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: right center;
    border-radius: var(--ff-radius-note);
    box-shadow: var(--ff-shadow-card);
  }

  .on-navy {
    font-size: var(--ff-size-h2);
    color: var(--ff-on-navy);
    margin: 0 0 20px;
    line-height: 1.1;
  }

  .on-navy-body {
    font-size: var(--ff-size-body-lg);
    line-height: 1.7;
    color: var(--ff-on-navy-soft);
    margin: 0 0 18px;
    max-width: 480px;
  }

  .on-navy-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ff-on-navy);
    font-weight: var(--ff-weight-semibold);
    font-size: var(--ff-size-body);
    text-decoration: none;
  }

  .on-navy-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--ff-on-navy);
  }

  .ba-section {
    padding: 80px var(--ff-gutter);
  }

  .reviews-band {
    background: var(--ff-band-blue);
  }

  .reviews-band .container {
    padding-top: 72px;
    padding-bottom: 72px;
  }

  .reviews-layout {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "head cta" "cards cards";
    column-gap: 28px;
  }

  .reviews-head {
    grid-area: head;
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .reviews-title-block {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .reviews-title {
    font-family: var(--ff-font-display);
    font-weight: var(--ff-weight-semibold);
    font-size: var(--ff-size-h3);
    color: var(--ff-navy);
    letter-spacing: var(--ff-tracking-tight);
  }

  .reviews-sub {
    font-size: var(--ff-size-caption);
    color: var(--ff-text-breadcrumb);
  }

  .rating-block {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .rating-number {
    font-family: var(--ff-font-display);
    font-size: 40px;
    font-weight: var(--ff-weight-semibold);
    color: var(--ff-text);
    line-height: 1;
  }

  .stars {
    color: #fbbc04;
    font-size: 19px;
    letter-spacing: 2px;
    line-height: 1;
  }

  .see-all-reviews {
    grid-area: cta;
    align-self: center;
  }

  .review-cards {
    grid-area: cards;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .reviews-coming-soon {
    grid-area: cards;
    color: var(--ff-text-breadcrumb);
    font-size: var(--ff-size-body);
  }

  @media (max-width: 780px) {
    .reviews-layout {
      grid-template-columns: 1fr;
      grid-template-areas: "head" "cards" "cta";
    }

    .see-all-reviews {
      justify-self: start;
      margin-top: 20px;
    }

    .review-cards {
      grid-template-columns: 1fr;
    }
  }

</style>
