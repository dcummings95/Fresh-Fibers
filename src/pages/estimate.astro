---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import site from '../content/site.json';

const title = `Free Estimate | ${site.name}, Winona, MN`;
const description = `Request a free carpet, upholstery, rug, tile, or pet odor cleaning estimate from ${site.name} in Winona, MN. No obligation.`;
---

<Base title={title} description={description}>
  <Fragment slot="hero">
    <div class="hero-copy">
      <div class="eyebrow">Free estimate</div>
      <h1>Tell me about the job. <span class="accent">I'll get right back.</span></h1>
      <p class="lead">No charge, no pressure. I'll give you an honest number, usually the same day.</p>
    </div>
  </Fragment>

  <section class="container layout">
    <QuoteForm />

    <aside class="sidebar">
      <div class="call-card">
        <div class="call-title">Or just call</div>
        <p>You'll get me, the person doing the work, not a call center.</p>
        <a href={`tel:${site.phoneTel}`} class="call-button">{site.phone}</a>
        <div class="call-hours">Call · {site.hours}</div>
      </div>

      <div class="next-card">
        <div class="next-title">What happens next</div>
        <div class="steps">
          <div class="step">
            <span class="step-num">1</span>
            <p>I get back to you the same day with an honest estimate.</p>
          </div>
          <div class="step">
            <span class="step-num">2</span>
            <p>We pick a time that works: a real window, not an all-day wait.</p>
          </div>
          <div class="step">
            <span class="step-num">3</span>
            <p>I confirm the price before I start. No surprises on the bill.</p>
          </div>
        </div>
      </div>
    </aside>
  </section>
</Base>

<style>
  .hero-copy {
    max-width: 720px;
    padding: 36px 0 0;
  }

  .hero-copy h1 {
    font-size: 54px;
    line-height: 1.04;
    margin: 18px 0 18px;
    letter-spacing: var(--ff-tracking-display);
  }

  .lead {
    font-size: var(--ff-size-body);
    line-height: 1.6;
    color: var(--ff-text-body);
    margin: 0;
  }

  @media (max-width: 640px) {
    .hero-copy {
      padding: 20px 0 0;
    }

    .hero-copy h1 {
      font-size: 38px;
    }
  }

  .layout {
    padding: 56px var(--ff-gutter) 80px;
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: 48px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  .call-card {
    background: var(--ff-navy);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--ff-radius-card);
    padding: 28px;
  }

  .call-title {
    font-family: var(--ff-font-display);
    font-weight: var(--ff-weight-semibold);
    font-size: 21px;
    color: var(--ff-on-navy);
    letter-spacing: var(--ff-tracking-tight);
    margin-bottom: 6px;
  }

  .call-card p {
    font-size: var(--ff-size-body-sm);
    color: var(--ff-on-navy-soft);
    margin: 0 0 18px;
    line-height: 1.6;
  }

  .call-button {
    display: block;
    text-align: center;
    background: var(--ff-azure);
    color: var(--ff-on-navy);
    padding: 14px;
    border-radius: var(--ff-radius-btn);
    font-weight: var(--ff-weight-bold);
    font-size: 20px;
    text-decoration: none;
    transition: background var(--ff-transition), transform var(--ff-transition);
  }

  .call-button:hover {
    background: var(--ff-azure-hover);
    color: var(--ff-on-navy);
  }

  @media (hover: hover) {
    .call-button:hover {
      transform: translateY(var(--ff-lift-hover));
    }
  }

  .call-hours {
    font-size: var(--ff-size-caption);
    color: var(--ff-on-navy-muted);
    margin-top: 14px;
    text-align: center;
  }

  .next-card {
    background: var(--ff-surface);
    border: 1px solid var(--ff-border-soft);
    border-radius: var(--ff-radius-card);
    box-shadow: var(--ff-shadow-card);
    padding: 26px;
  }

  .next-title {
    font-family: var(--ff-font-display);
    font-weight: var(--ff-weight-semibold);
    font-size: 20px;
    color: var(--ff-navy);
    letter-spacing: var(--ff-tracking-tight);
    margin-bottom: 16px;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .step {
    display: flex;
    gap: 12px;
  }

  .step-num {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--ff-fill-blue);
    color: var(--ff-azure);
    font-weight: var(--ff-weight-bold);
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step p {
    font-size: var(--ff-size-body-sm);
    line-height: 1.55;
    color: var(--ff-text-body);
    margin: 0;
  }

  .guarantee-card {
    background: var(--ff-fill-blue);
    border: 1px solid rgba(22, 53, 115, 0.14);
    border-radius: var(--ff-radius-card);
    padding: 24px;
  }

  @media (max-width: 640px) {
    .call-card,
    .next-card,
    .guarantee-card {
      padding: 22px 20px;
      border-radius: var(--ff-radius-card-mobile);
    }
  }

  .badge {
    display: inline-block;
    background: var(--ff-surface);
    color: var(--ff-azure);
    font-weight: var(--ff-weight-bold);
    font-size: 13px;
    letter-spacing: var(--ff-tracking-eyebrow);
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: var(--ff-radius-pill);
    margin-bottom: 12px;
  }

  .guarantee-card p {
    font-size: var(--ff-size-body-sm);
    line-height: 1.6;
    color: var(--ff-text-body);
    margin: 0;
  }
</style>
