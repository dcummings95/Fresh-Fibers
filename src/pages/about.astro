---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import site from '../content/site.json';
import augieVan from '../assets/images/Various/augie_van.jpeg';
import vanPhoto from '../assets/images/Various/ff-van-passenger-side-long.jpg';
import truckmountPhoto from '../assets/images/Various/ff_van_doors_open.jpg';

const title = `About ${site.ownerName} | ${site.name}, Winona, MN`;
const description = `${site.name} is a one-person carpet and upholstery cleaning business in Winona, MN, run by owner ${site.ownerName}. No subcontractors, no rotating crews.`;
---

<Base title={title} description={description} heroFlush>
  <Fragment slot="hero">
    <Breadcrumb theme="onNavy" items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
    <div class="hero-copy">
      <div class="eyebrow accent-on-navy">About {site.name}</div>
      <h1>One person, one van, <span class="accent accent-on-navy">no subcontractors.</span></h1>
      <p class="lead">
        Every job that gets booked, I'm the one who shows up and does the work myself.
      </p>
      <div class="cta-row">
        <a href="/estimate" class="btn btn-azure">Free estimate</a>
        <a href={`tel:${site.phoneTel}`} class="btn btn-tertiary">Call Now</a>
      </div>
    </div>
    <div class="hero-photo-shape">
      <Image src={vanPhoto} alt={`The ${site.name} van`} style="object-position: center 70%" width={1000} height={750} loading="eager" fetchpriority="high" />
    </div>
  </Fragment>

  <section class="container story-section">
    <Image src={augieVan} alt={`${site.ownerName} with the Fresh Fibers van`} class="story-photo" width={640} height={640} />
    <div class="story-copy">
      <h2>How this started</h2>
      <p>
        I'm {site.ownerName}. Helping others has always been a passion of mine, and {site.legalName} started the way
        a lot of small local businesses do, doing a good job for one neighbor, then the next one, until
        it was steady enough to run full-time out of a truckmount van. I love the work, and I love the people I get to meet along the way.
      </p>
      <p>
        This business is new, but my experience is not. Prior to opening Fresh Fibers I cleaned carpet professionally for several years. As of now, it's just me and my van! Keeping it to one person means every job gets
        the same hands, the same standards, and the same care I'd want in my own house. It means
        when you call, you're talking straight to the person who's going to show up and do the work.
      </p>
    </div>
  </section>

  <section class="container truckmount-section">
    <div class="truckmount-copy">
      <h2>A real truckmount</h2>
      <p>
        The van runs a HydraMaster Titan 375, a true truckmount hot-water extraction system, the same class of
        equipment the larger crews run. It heats water hotter and pulls a lot more vacuum than the rental
        machines or portable extractors some smaller operations use, which means a deeper clean and carpet
        that's dry again in hours instead of a day or two.
      </p>
      <p>
        The whole system, tanks, heater, and vacuum, lives in the van, so nothing gets dragged through your
        house but the hose and wand. Just the machine doing the work outside, and a clean, quiet job inside.
      </p>
    </div>
    <Image src={truckmountPhoto} alt="The HydraMaster Titan 375 truckmount unit installed in the Fresh Fibers van" class="truckmount-photo" width={900} height={675} />
  </section>

  <section class="container equipment-section">
    <h2>What that means for you</h2>
    <div class="points">
      <div class="point">
        <div class="point-title">You get me, every time</div>
        <p>No subcontractors, no unfamiliar faces. The person who quotes the job is the person who does it.</p>
      </div>
      <div class="point">
        <div class="point-title">Professional-grade truckmount system</div>
        <p>A real HydraMaster truckmount, not a rental unit, hotter water and stronger vacuum for a deeper clean and a faster dry.</p>
      </div>
      <div class="point">
        <div class="point-title">Honest, upfront pricing</div>
        <p>My rates are published on this site because I'd rather earn the job on trust than surprise you with a number after I've already started.</p>
      </div>
      <div class="point">
        <div class="point-title">Accountable if something's off</div>
        <p>There's no one else to blame and no one else to fix it. If a job's not right, I come back and make it right, on my dime.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-copy {
    position: relative;
    z-index: 1;
    padding: 28px 0 48px;
  }

  @media (min-width: 861px) {
    .hero-copy {
      max-width: 540px;
      padding: 56px 0;
    }
  }

  .hero-copy h1 {
    color: var(--ff-on-navy);
    font-size: var(--ff-size-h1);
    line-height: 1.03;
    margin: 18px 0 24px;
    letter-spacing: var(--ff-tracking-display);
  }

  .cta-row {
    display: flex;
    gap: 18px;
    align-items: center;
    flex-wrap: wrap;
  }

  .lead {
    font-size: var(--ff-size-body);
    line-height: 1.6;
    color: var(--ff-on-navy-soft);
    margin: 0 0 18px;
  }

  @media (max-width: 640px) {
    .hero-copy h1 {
      font-size: 40px;
    }
  }

  .story-section {
    padding: 72px var(--ff-gutter);
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--ff-gap-lg);
    align-items: center;
  }

  .story-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: right center;
    border-radius: var(--ff-radius-note);
    box-shadow: var(--ff-shadow-card);
  }

  @media (max-width: 780px) {
    .story-section {
      grid-template-columns: 1fr;
    }
  }

  .story-copy h2 {
    font-size: var(--ff-size-h2);
    margin-bottom: 20px;
  }

  .story-copy p {
    font-size: var(--ff-size-body-lg);
    line-height: 1.7;
    color: var(--ff-text-body);
    margin: 0 0 18px;
  }

  .story-copy p:last-child {
    margin-bottom: 0;
  }

  .truckmount-section {
    padding: 0 var(--ff-gutter) 72px;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--ff-gap-lg);
    align-items: center;
  }

  .truckmount-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--ff-radius-note);
    box-shadow: var(--ff-shadow-card);
  }

  @media (max-width: 780px) {
    .truckmount-section {
      grid-template-columns: 1fr;
    }

    .truckmount-section .truckmount-photo {
      order: -1;
    }
  }

  .truckmount-copy h2 {
    font-size: var(--ff-size-h2);
    margin-bottom: 20px;
  }

  .truckmount-copy p {
    font-size: var(--ff-size-body-lg);
    line-height: 1.7;
    color: var(--ff-text-body);
    margin: 0 0 18px;
  }

  .truckmount-copy p:last-child {
    margin-bottom: 0;
  }

  .equipment-section {
    padding: 0 var(--ff-gutter) 80px;
  }

  .equipment-section h2 {
    font-size: var(--ff-size-h2);
    margin-bottom: 32px;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  @media (max-width: 700px) {
    .points {
      grid-template-columns: 1fr;
    }
  }

  .point-title {
    font-weight: var(--ff-weight-bold);
    color: var(--ff-text);
    font-size: var(--ff-size-body-lg);
    margin-bottom: 8px;
  }

  .points p {
    font-size: var(--ff-size-body);
    line-height: 1.6;
    color: var(--ff-text-muted);
    margin: 0;
  }
</style>
