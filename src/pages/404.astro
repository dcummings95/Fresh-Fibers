---
import Base from '../layouts/Base.astro';
import site from '../content/site.json';

const title = `Page Not Found | ${site.name}`;
const description = `That page doesn't exist. Find services or get in touch with ${site.name}.`;
---

<Base title={title} description={description}>
  <Fragment slot="hero">
    <div class="hero-copy">
      <div class="eyebrow">404</div>
      <h1>That page washed <span class="accent">out.</span></h1>
      <p class="lead">The page you're looking for doesn't exist, or it's moved.</p>
    </div>
  </Fragment>

  <section class="container links-section">
    <a href="/services" class="btn btn-primary">See all services</a>
    <a href={`tel:${site.phoneTel}`} class="btn-tertiary">Call {site.phone}</a>
    <a href="/" class="btn-tertiary">Back to homepage</a>
  </section>
</Base>

<style>
  .hero-copy {
    max-width: 560px;
    padding: 48px 0 0;
  }

  .hero-copy h1 {
    font-size: var(--ff-size-h1);
    line-height: 1.03;
    margin: 18px 0 20px;
    letter-spacing: var(--ff-tracking-display);
  }

  .lead {
    font-size: var(--ff-size-lead);
    line-height: 1.6;
    color: var(--ff-text-body);
    margin: 0;
  }

  .links-section {
    padding: 64px var(--ff-gutter) 96px;
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
</style>
