---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HubLinks from '../../components/HubLinks.astro';
import site from '../../content/site.json';
import heroPhoto from '../../assets/images/Various/carpet_midway_clean_4.jpg';

const title = `Service Areas | ${site.name}, Winona, MN & La Crosse, WI`;
const description = `${site.name} cleans carpets, upholstery, and rugs in ${site.serviceAreas.length} towns across the Driftless Region — Winona and Rochester, MN, La Crosse, WI, and within ${site.serviceRadiusMiles} miles.`;

const stateNames = { WI: 'Wisconsin', MN: 'Minnesota' };
const areasByState = site.serviceAreas.reduce((groups, area) => {
  const state = area.slice(-2);
  (groups[state] ??= []).push(area);
  return groups;
}, {});
---

<Base title={title} description={description} heroFlush>
  <Fragment slot="hero">
    <Breadcrumb theme="onNavy" items={[{ label: 'Home', href: '/' }, { label: 'Service Areas' }]} />
    <div class="hero-copy">
      <div class="eyebrow accent-on-navy">Where I work</div>
      <h1>Serving the river valley, <span class="accent accent-on-navy">bluff to bluff.</span></h1>
      <p class="lead">{site.serviceAreaNote}</p>
      <div class="cta-row">
        <a href="/estimate" class="btn btn-azure">Free estimate</a>
        <a href={`tel:${site.phoneTel}`} class="btn btn-tertiary">Call Now</a>
      </div>
    </div>
    <div class="hero-photo-shape">
      <Image src={heroPhoto} alt={`Carpet cleaning mid-job in a customer's home`} style="object-position: 15% 75%" width={1000} height={750} fit="cover" loading="eager" fetchpriority="high" />
    </div>
  </Fragment>

  <section class="container map-section">
    <div
      id="coverage-map"
      data-center-lat={site.mapCenter.lat}
      data-center-lng={site.mapCenter.lng}
      data-radius-miles={site.serviceRadiusMiles}
      role="img"
      aria-label={`Map showing the roughly ${site.serviceRadiusMiles}-mile service area centered on Winona, MN`}
    ></div>
  </section>

  <section class="container coverage-section">
    <h2>Full coverage area</h2>
    <p class="coverage-intro">{site.serviceAreaNote}</p>
    {['MN', 'WI'].map((state) => (
      <div class="state-group">
        <h3>{stateNames[state]}</h3>
        <ul class="town-list">
          {areasByState[state].map((area) => (
            <li>{area}</li>
          ))}
        </ul>
      </div>
    ))}
    <p class="coverage-note">
      I clean regularly in all of the towns above. If you're nearby and don't see your town listed,{' '}
      <a href="/estimate">just ask</a>, chances are I already cover it.
    </p>
  </section>

  <section class="container hub-links-section">
    <HubLinks current="areas" />
  </section>
</Base>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  const el = document.getElementById('coverage-map');

  if (el) {
    const lat = parseFloat(el.dataset.centerLat ?? '');
    const lng = parseFloat(el.dataset.centerLng ?? '');
    const radiusMiles = parseFloat(el.dataset.radiusMiles ?? '');
    const radiusMeters = radiusMiles * 1609.34;
    const center: [number, number] = [lat, lng];

    const map = L.map(el, { scrollWheelZoom: false }).setView(center, 8);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 18,
    }).addTo(map);

    const coverage = L.circle(center, {
      radius: radiusMeters,
      color: '#0B6FB8',
      weight: 2,
      fillColor: '#0B6FB8',
      fillOpacity: 0.08,
    }).addTo(map);

    L.circleMarker(center, {
      radius: 6,
      color: '#163573',
      weight: 2,
      fillColor: '#183F8C',
      fillOpacity: 1,
    }).addTo(map).bindPopup('Fresh Fibers home base — Winona, MN');

    map.fitBounds(coverage.getBounds(), { padding: [12, 12] });
  }
</script>

<style>
  .hero-copy {
    position: relative;
    z-index: 1;
    padding: 28px 0 48px;
  }

  @media (min-width: 861px) {
    .hero-copy {
      max-width: 540px;
      padding: 56px 0;
    }
  }

  .hero-copy h1 {
    color: var(--ff-on-navy);
    font-size: var(--ff-size-h1);
    line-height: 1.03;
    margin: 18px 0 24px;
    letter-spacing: var(--ff-tracking-display);
  }

  .cta-row {
    display: flex;
    gap: 18px;
    align-items: center;
    flex-wrap: wrap;
  }

  .lead {
    font-size: var(--ff-size-body);
    line-height: 1.6;
    color: var(--ff-on-navy-soft);
    margin: 0 0 18px;
  }

  @media (max-width: 640px) {
    .hero-copy h1 {
      font-size: 40px;
    }
  }

  .coverage-section {
    padding: 40px var(--ff-gutter) 24px;
    max-width: 700px;
  }

  .coverage-section h2 {
    font-size: var(--ff-size-h2);
    margin-bottom: 16px;
  }

  .coverage-intro {
    font-size: var(--ff-size-body-lg);
    line-height: 1.6;
    color: var(--ff-text-body);
    margin: 0 0 24px;
  }

  .state-group {
    margin-bottom: 24px;
  }

  .state-group h3 {
    font-size: var(--ff-size-caption);
    font-weight: var(--ff-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--ff-tracking-eyebrow);
    color: var(--ff-text-muted);
    margin: 0 0 12px;
  }

  .town-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 0;
  }

  .town-list li {
    background: var(--ff-fill-blue);
    color: var(--ff-navy-cta);
    font-weight: var(--ff-weight-semibold);
    font-size: var(--ff-size-body-sm);
    border: 1px solid rgba(22, 53, 115, 0.18);
    padding: 7px 15px;
    border-radius: var(--ff-radius-pill);
  }

  .coverage-note {
    font-size: var(--ff-size-body-sm);
    line-height: 1.6;
    color: var(--ff-text-muted);
    margin: 0;
  }

  .hub-links-section {
    padding: 24px var(--ff-gutter) 80px;
    max-width: 700px;
  }

  .map-section {
    padding: 64px var(--ff-gutter) 0;
    max-width: 700px;
  }

  #coverage-map {
    width: 100%;
    height: 380px;
    border-radius: var(--ff-radius-card);
    border: 1px solid var(--ff-border-soft);
    box-shadow: var(--ff-shadow-card);
  }

  @media (max-width: 640px) {
    #coverage-map {
      height: 280px;
      border-radius: var(--ff-radius-card-mobile);
    }
  }
</style>
