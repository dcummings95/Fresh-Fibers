---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ReviewCard from '../components/ReviewCard.astro';
import Callout from '../components/Callout.astro';
import site from '../content/site.json';
import reviewsData from '../content/reviews.json';
import winonaBridge from '../assets/images/Various/winona_bridge.jpg';

const title = `Reviews | ${site.name}, Winona, MN`;
const description = `Read what homeowners around Winona, MN and La Crosse, WI say about ${site.name} carpet, upholstery, and rug cleaning: on time, fair pricing, no upsells.`;

const avatarColors = ['var(--ff-navy-cta)', 'var(--ff-azure)', 'var(--ff-accent-on-navy)', 'var(--ff-accent-on-navy)', 'var(--ff-azure-hover)', 'var(--ff-navy-panel)'];
---

<Base title={title} description={description} heroFlush>
  <Fragment slot="hero">
    <Breadcrumb theme="onNavy" items={[{ label: 'Home', href: '/' }, { label: 'Reviews' }]} />
    <div class="hero-copy">
      <div class="eyebrow accent-on-navy">What neighbors say</div>
      <h1>Reviews from around <span class="accent accent-on-navy">Winona.</span></h1>
      <p class="lead">Straight feedback from finished jobs.</p>
      <div class="cta-row">
        <a href="/estimate" class="btn btn-azure">Free estimate</a>
        <a href={`tel:${site.phoneTel}`} class="btn btn-tertiary">Call Now</a>
      </div>
    </div>
    <div class="hero-photo-shape">
      <Image src={winonaBridge} alt="The bridge over the Mississippi in Winona, MN" width={1080} height={864} fit="cover" widths={[540, 720, 1080, 1440, 1800, 2160]} sizes="(min-width: 861px) 54vw, 100vw" loading="eager" fetchpriority="high" />
    </div>
  </Fragment>

  {reviewsData.placeholder ? (
    <section class="container coming-soon">
      <p class="eyebrow">Reviews coming soon</p>
      <p>We're just getting started! Check back soon for feedback from jobs around Winona.</p>
    </section>
  ) : (
    <>
      <section class="container rating-section">
        <span class="rating-number">{reviewsData.aggregateRating.toFixed(1)}</span>
        <div>
          <div class="stars">★★★★★</div>
          <div class="rating-count">
            {reviewsData.reviews.length} review{reviewsData.reviews.length === 1 ? '' : 's'}
          </div>
        </div>
      </section>

      <section class="container review-grid">
        {reviewsData.reviews.map((review, i) => (
          <ReviewCard
            name={review.name}
            when={review.when}
            rating={review.rating}
            text={review.text}
            avatarColor={avatarColors[i % avatarColors.length]}
          />
        ))}
      </section>
    </>
  )}

  <section class="container cta-section">
    <Callout title="Leave a quick review">
      A quick Google review helps a one-person business more than you'd think.
      <div slot="action"><a href="/review" class="btn btn-primary">Leave a review</a></div>
    </Callout>
  </section>
</Base>

<style>
  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 600px;
    padding: 28px 0 48px;
  }

  @media (min-width: 861px) {
    .hero-copy {
      max-width: 540px;
      padding: 56px 0;
    }
  }

  .hero-copy h1 {
    color: var(--ff-on-navy);
    font-size: var(--ff-size-h1);
    line-height: 1.03;
    margin: 18px 0 24px;
    letter-spacing: var(--ff-tracking-display);
  }

  .cta-row {
    display: flex;
    gap: 18px;
    align-items: center;
    flex-wrap: wrap;
  }

  .lead {
    font-size: var(--ff-size-body);
    line-height: 1.6;
    color: var(--ff-on-navy-soft);
    margin: 0 0 18px;
  }

  @media (max-width: 640px) {
    .hero-copy h1 {
      font-size: 40px;
    }
  }

  .coming-soon {
    padding: 56px var(--ff-gutter) 64px;
    text-align: center;
  }

  .coming-soon .eyebrow {
    color: var(--ff-navy-cta);
    font-weight: var(--ff-weight-semibold);
    margin-bottom: 8px;
  }

  .coming-soon p:not(.eyebrow) {
    color: var(--ff-text-breadcrumb);
    font-size: var(--ff-size-body);
  }

  .rating-section {
    padding: 56px var(--ff-gutter) 32px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .rating-number {
    font-family: var(--ff-font-display);
    font-size: 50px;
    font-weight: var(--ff-weight-semibold);
    color: var(--ff-text);
    line-height: 1;
  }

  .stars {
    color: #fbbc04;
    font-size: 22px;
    letter-spacing: 2px;
    line-height: 1;
  }

  .rating-count {
    font-size: var(--ff-size-caption);
    color: var(--ff-text-breadcrumb);
    margin-top: 6px;
  }

  .review-grid {
    padding: 0 var(--ff-gutter) 64px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 780px) {
    .review-grid {
      grid-template-columns: 1fr;
    }
  }

  .cta-section {
    padding: 0 var(--ff-gutter) 80px;
  }
</style>
