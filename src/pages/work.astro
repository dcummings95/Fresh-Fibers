---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import site from '../content/site.json';
import { services } from '../lib/services';
import { servicePhotos } from '../lib/photos';

const title = `Before & After Photos | ${site.name}, Winona, MN`;
const description = `See real carpet, upholstery, rug, and tile cleaning results from ${site.name} around Winona, MN.`;
---

<Base title={title} description={description} heroFlush>
  <Fragment slot="hero">
    <Breadcrumb theme="onNavy" items={[{ label: 'Home', href: '/' }, { label: 'Before & After' }]} />
    <div class="hero-copy">
      <div class="eyebrow accent-on-navy">See the results</div>
      <h1>Before &amp; <span class="accent accent-on-navy">after.</span></h1>
      <p class="lead">Drag any slider to compare real jobs from around Winona.</p>
      <div class="cta-row">
        <a href="/estimate" class="btn btn-azure">Free estimate</a>
        <a href={`tel:${site.phoneTel}`} class="btn btn-tertiary">Call Now</a>
      </div>
    </div>
  </Fragment>

  <section class="container gallery">
    {services.map((service) => {
      const photo = servicePhotos[service.slug] ?? {};
      return (
        <div class="gallery-item">
          <div class="item-head">
            <h2>{service.navLabel}</h2>
            <a href={`/services/${service.route}`} class="btn btn-tertiary">Service details <span class="arrow">→</span></a>
          </div>
          <BeforeAfterSlider
            beforeImage={photo.before}
            afterImage={photo.after}
            beforePosition={photo.beforePosition}
            afterPosition={photo.afterPosition}
            beforeLabel={`BEFORE · ${service.navLabel}`}
            afterLabel={`AFTER · ${service.navLabel}`}
            alt={service.navLabel}
          />
        </div>
      );
    })}
  </section>
</Base>

<style>
  .hero-copy {
    max-width: 600px;
    padding: 28px 0 48px;
  }

  .hero-copy h1 {
    color: var(--ff-on-navy);
    font-size: var(--ff-size-h1);
    line-height: 1.03;
    margin: 18px 0 24px;
    letter-spacing: var(--ff-tracking-display);
  }

  .cta-row {
    display: flex;
    gap: 18px;
    align-items: center;
  }

  .lead {
    font-size: var(--ff-size-body);
    line-height: 1.6;
    color: var(--ff-on-navy-soft);
    margin: 0 0 18px;
  }

  @media (max-width: 640px) {
    .hero-copy h1 {
      font-size: 40px;
    }
  }

  .gallery {
    padding: 64px var(--ff-gutter) 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }

  @media (max-width: 780px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }

  .item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .item-head h2 {
    font-size: var(--ff-size-h3);
  }

  .arrow {
    color: var(--ff-azure);
  }
</style>
