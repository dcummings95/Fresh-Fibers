---
import site from '../content/site.json';
---

<a href={`tel:${site.phoneTel}`} class="mobile-call-button">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.5 21 3 13.5 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z"
      fill="currentColor"
    />
  </svg>
  Call {site.phone}
</a>

<style>
  .mobile-call-button {
    display: none;
  }

  @media (max-width: 640px) {
    .mobile-call-button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: 12px;
      z-index: 40;
      background: var(--ff-navy-cta);
      color: #fff;
      font-weight: var(--ff-weight-semibold);
      font-size: var(--ff-size-body);
      padding: 14px;
      border-radius: var(--ff-radius-btn);
      text-decoration: none;
      box-shadow: var(--ff-shadow-hover);
      padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
