---
import ServicePhoto from './ServicePhoto.astro';

interface Props {
  href: string;
  slug: string;
  title: string;
  description: string;
  photoLabel: string;
}

const { href, slug, title, description, photoLabel } = Astro.props;
---

<a href={href} class="service-card">
  <ServicePhoto slug={slug} label={photoLabel} alt={title} aspectRatio="3 / 2" rounded={false} />
  <div class="body">
    <div class="title">{title}</div>
    <p class="description">{description}</p>
    <div class="footer">
      <span class="view">View <span class="arrow">→</span></span>
    </div>
  </div>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    background: var(--ff-surface);
    border-radius: var(--ff-radius-card);
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--ff-shadow-card);
    transition: box-shadow var(--ff-transition), transform var(--ff-transition);
  }

  .service-card:hover {
    box-shadow: var(--ff-shadow-hover);
  }

  @media (hover: hover) {
    .service-card:hover {
      transform: translateY(var(--ff-lift-hover));
    }
  }

  .body {
    padding: 24px 24px 26px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  @media (max-width: 640px) {
    .service-card {
      box-shadow: none;
      border-radius: var(--ff-radius-card-mobile);
    }

    .body {
      padding: 20px 20px 22px;
    }
  }

  .title {
    font-family: var(--ff-font-display);
    font-weight: var(--ff-weight-semibold);
    font-size: var(--ff-size-card-title);
    color: var(--ff-navy);
    letter-spacing: var(--ff-tracking-tight);
    margin-bottom: 8px;
  }

  .description {
    font-size: var(--ff-size-body-sm);
    line-height: 1.6;
    color: var(--ff-text-muted);
    margin: 0 0 20px;
    flex: 1;
  }

  .footer {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    padding-top: 18px;
  }

  .view {
    color: var(--ff-navy-cta);
    font-weight: var(--ff-weight-semibold);
    font-size: var(--ff-size-body-sm);
    white-space: nowrap;
  }

  .arrow {
    color: var(--ff-azure);
  }
</style>
