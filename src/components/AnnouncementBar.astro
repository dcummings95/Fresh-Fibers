---
import { promo } from '../lib/promo';
---

{promo && (
  <div class="announcement-bar" id="announcement-bar">
    <div class="announcement-inner">
      <p>
        <strong>{promo.percentOff}% off</strong> your entire cleaning through {promo.endDateLabel}.
      </p>
      <a href="/estimate" class="announcement-cta">Get your free estimate →</a>
    </div>
  </div>
)}

<script>
  // Pages are prerendered, so the sale can't expire on its own between
  // deploys, so check the visitor's own clock and drop the bar once it's past.
  import { isPromoActive } from '../lib/promo';

  if (!isPromoActive()) document.getElementById('announcement-bar')?.remove();
</script>

<style>
  .announcement-bar {
    background: var(--ff-navy-cta);
    color: var(--ff-on-navy);
  }

  .announcement-inner {
    max-width: var(--ff-container);
    margin: 0 auto;
    padding: 10px var(--ff-gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 16px;
    text-align: center;
  }

  .announcement-inner p {
    margin: 0;
    font-size: var(--ff-size-caption);
  }

  .announcement-cta {
    color: var(--ff-on-navy);
    font-weight: var(--ff-weight-bold);
    font-size: var(--ff-size-caption);
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }

  .announcement-cta:hover {
    color: var(--ff-accent-on-navy);
  }
</style>
