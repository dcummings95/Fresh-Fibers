---
import { Image } from 'astro:assets';
import site from '../content/site.json';
import logo from '../assets/images/logo.png';
---

<footer class="site-footer">
  <div class="band">
    <div class="container band-inner">
      <div class="guarantee">
        <div class="badge">{site.guaranteeDays}-day guarantee</div>
        <h2>If it's not right, <span class="accent accent-on-navy">I'll make it right.</span></h2>
        <p>Not happy within {site.guaranteeDays} days of your cleaning? Call me and I'll come back and re-clean the area — no charge, no hassle.</p>
      </div>
      <div class="panel bleed-sm">
        <h3>Book a time</h3>
        <p>Book online or call — free estimate, no pressure.</p>
        <div class="actions">
          <a href="/book" class="btn btn-azure">Book online</a>
          <a href={`tel:${site.phoneTel}`} class="call-link">Call {site.phone}</a>
        </div>
      </div>
    </div>
  </div>

  <div class="container inner">
    <div class="brand-block">
      <Image src={logo} width={44} height={44} alt={`${site.name} logo`} />
      <div>
        <div class="legal-name">{site.legalName}</div>
        <div class="meta">Winona, MN · {site.hoursShort}</div>
      </div>
    </div>
    <div class="links">
      <a href={`tel:${site.phoneTel}`} class="phone">{site.phone}</a>
      <span class="dot">·</span>
      <a href="/book" class="book-link">Book online</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ff-navy-deep);
  }

  .band {
    background: var(--ff-navy);
  }

  .band-inner {
    padding: 72px var(--ff-gutter);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ff-gap-lg);
    align-items: center;
  }

  @media (max-width: 780px) {
    .band-inner {
      grid-template-columns: 1fr;
    }
  }

  .badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.14);
    color: var(--ff-accent-on-navy);
    font-weight: var(--ff-weight-bold);
    font-size: var(--ff-size-micro);
    letter-spacing: var(--ff-tracking-eyebrow);
    text-transform: uppercase;
    padding: 8px 16px;
    border-radius: var(--ff-radius-pill);
    margin-bottom: 20px;
  }

  .guarantee h2 {
    font-size: 40px;
    color: var(--ff-on-navy);
    margin: 0 0 16px;
    line-height: 1.1;
  }

  .guarantee p {
    font-size: var(--ff-size-body-lg);
    line-height: 1.7;
    color: var(--ff-on-navy-soft);
    margin: 0;
    max-width: 440px;
  }

  .panel {
    background: var(--ff-navy-panel);
    border-radius: var(--ff-radius-inner);
    padding: 36px;
  }

  @media (max-width: 640px) {
    .panel {
      padding: 28px 20px;
    }
  }

  .panel h3 {
    font-size: var(--ff-size-h3);
    color: var(--ff-on-navy);
    margin: 0 0 8px;
  }

  .panel p {
    font-size: var(--ff-size-body);
    color: var(--ff-on-navy-muted);
    margin: 0 0 24px;
  }

  .actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .call-link {
    display: inline-flex;
    align-items: center;
    color: var(--ff-on-navy);
    font-weight: var(--ff-weight-semibold);
    font-size: var(--ff-size-body);
    text-decoration: none;
  }

  .call-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--ff-on-navy);
  }

  .inner {
    padding: 40px var(--ff-gutter);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .brand-block {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .legal-name {
    font-family: var(--ff-font-display);
    font-weight: var(--ff-weight-semibold);
    font-size: 19px;
    color: var(--ff-on-navy);
  }

  .meta {
    font-size: var(--ff-size-micro);
    color: var(--ff-on-navy-muted);
    margin-top: 2px;
  }

  .links {
    font-size: var(--ff-size-caption);
    color: var(--ff-on-navy-muted);
  }

  .phone {
    color: var(--ff-on-navy);
    font-weight: var(--ff-weight-semibold);
    text-decoration: none;
  }

  .dot {
    margin: 0 10px;
    color: var(--ff-on-navy-muted);
  }

  .book-link {
    color: var(--ff-accent-on-navy);
    text-decoration: none;
    font-weight: var(--ff-weight-semibold);
  }
</style>
