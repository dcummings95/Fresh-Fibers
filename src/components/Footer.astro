---
import { Image } from 'astro:assets';
import site from '../content/site.json';
import logo from '../assets/images/logo.png';
import { services } from '../lib/services';

const serviceLinks = services.map((s) => ({ href: `/services/${s.route}`, label: s.navLabel }));
const coreServiceLinks = serviceLinks.slice(0, 4);
const moreServiceLinks = serviceLinks.slice(4);

const linkColumns = [
  {
    heading: 'Services',
    links: coreServiceLinks,
  },
  {
    heading: 'Specialty Services',
    links: [...moreServiceLinks, { href: '/services', label: 'All Services' }],
  },
  {
    heading: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/work', label: 'Our Work' },
      { href: '/reviews', label: 'Reviews' },
      { href: '/areas', label: 'Service Areas' },
    ],
  },
  {
    heading: 'Get Started',
    links: [
      { href: '/pricing', label: 'Pricing' },
      { href: '/estimate', label: 'Free Estimate' },
      { href: `tel:${site.phoneTel}`, label: site.phone },
      { href: `mailto:${site.email}`, label: site.email },
    ],
  },
];
---

<footer class="site-footer">
  <div class="band">
    <div class="container band-inner">
      <div class="guarantee">
        <div class="badge">{site.guaranteeDays}-day guarantee</div>
        <h2>If it's not right, <span class="accent accent-on-navy">I'll make it right.</span></h2>
        <p>Not happy within {site.guaranteeDays} days of your cleaning? Call me and I'll come back and re-clean the area, no charge, no hassle.</p>
      </div>
      <div class="panel bleed-sm">
        <h3>Get your free estimate</h3>
        <p>Request one online or give me a call, no pressure, no obligation.</p>
        <div class="actions">
          <a href="/estimate" class="btn btn-azure">Free estimate</a>
          <a href={`tel:${site.phoneTel}`} class="btn btn-tertiary">Call Now</a>
        </div>
      </div>
    </div>
  </div>

  <div class="container inner">
    <div class="brand-block">
      <Image src={logo} width={44} height={44} alt={`${site.name} logo`} />
      <div>
        <div class="legal-name">{site.legalName}</div>
        <div class="meta">Winona, MN · {site.hoursShort}</div>
      </div>
    </div>

    <nav class="sitemap sitemap-desktop" aria-label="Footer">
      {linkColumns.map((column) => (
        <div class="sitemap-col">
          <div class="sitemap-heading">{column.heading}</div>
          <ul>
            {column.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <nav class="sitemap sitemap-mobile" aria-label="Footer">
      {linkColumns.map((column) => (
        <details class="sitemap-col">
          <summary class="sitemap-heading">{column.heading}</summary>
          <ul>
            {column.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </details>
      ))}
    </nav>
  </div>

  <div class="container bottom-bar">
    <div class="copyright">© {new Date().getFullYear()} {site.legalName}. All rights reserved.</div>
    <div class="social">
      <a href={`mailto:${site.email}`} class="social-link" aria-label="Email Fresh Fibers">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="m22 6-10 7L2 6"></path>
        </svg>
      </a>
      <a href={site.instagramUrl} class="social-link" aria-label="Fresh Fibers on Instagram" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ff-navy-deep);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .band {
    background: var(--ff-navy);
  }

  .band-inner {
    padding: 72px var(--ff-gutter) 48px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ff-gap-lg);
    align-items: end;
  }

  @media (max-width: 780px) {
    .band-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .band-inner {
      padding-bottom: 0;
    }
  }

  .badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.14);
    color: var(--ff-accent-on-navy);
    font-weight: var(--ff-weight-bold);
    font-size: var(--ff-size-micro);
    letter-spacing: var(--ff-tracking-eyebrow);
    text-transform: uppercase;
    padding: 8px 16px;
    border-radius: var(--ff-radius-pill);
    margin-bottom: 20px;
  }

  .guarantee h2 {
    font-size: 40px;
    color: var(--ff-on-navy);
    margin: 0 0 16px;
    line-height: 1.1;
  }

  .guarantee p {
    font-size: var(--ff-size-body-lg);
    line-height: 1.7;
    color: var(--ff-on-navy-soft);
    margin: 0;
    max-width: 440px;
  }

  .panel {
    background: var(--ff-navy-deep);
    border-radius: var(--ff-radius-inner);
    padding: 36px;
  }

  @media (max-width: 640px) {
    .panel {
      padding: 28px 20px;
      border-radius: 0;
    }
  }

  .panel h3 {
    font-size: var(--ff-size-h3);
    color: var(--ff-on-navy);
    margin: 0 0 8px;
  }

  .panel p {
    font-size: var(--ff-size-body);
    color: var(--ff-on-navy-muted);
    margin: 0 0 24px;
  }

  .actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .inner {
    padding: 48px var(--ff-gutter) 32px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .brand-block {
    display: flex;
    align-items: center;
    gap: 11px;
    flex-shrink: 0;
  }

  .legal-name {
    font-family: var(--ff-font-display);
    font-weight: var(--ff-weight-semibold);
    font-size: 19px;
    color: var(--ff-on-navy);
  }

  .meta {
    font-size: var(--ff-size-micro);
    color: var(--ff-on-navy-muted);
    margin-top: 2px;
  }

  .sitemap-heading {
    font-size: var(--ff-size-micro);
    font-weight: var(--ff-weight-bold);
    letter-spacing: var(--ff-tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ff-accent-on-navy);
    margin-bottom: 14px;
    list-style: none;
  }

  .sitemap-heading::-webkit-details-marker {
    display: none;
  }

  .sitemap-heading::marker {
    content: '';
  }

  .sitemap-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sitemap-col a {
    font-size: var(--ff-size-body-sm);
    color: var(--ff-on-navy-muted);
    text-decoration: none;
    transition: color var(--ff-transition);
    overflow-wrap: anywhere;
  }

  .sitemap-col a:hover,
  .sitemap-col a:focus-visible {
    color: var(--ff-on-navy);
  }

  /* Desktop: static, always-expanded columns, evenly spaced */
  .sitemap-desktop {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex: 1;
  }

  .sitemap-desktop .sitemap-col {
    flex: 0 0 auto;
  }

  .sitemap-mobile {
    display: none;
  }

  /* 1080px, not a smaller "tablet" number: the four desktop columns plus
     the brand block genuinely need ~1080px of page width, so anything
     lower leaves them overflowing the page rather than wrapping. */
  @media (max-width: 1080px) {
    .inner {
      flex-direction: column;
      gap: 32px;
    }

    .sitemap-desktop {
      display: none;
    }

    .sitemap-mobile {
      display: block;
      width: 100%;
    }

    .sitemap-mobile .sitemap-col {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .sitemap-mobile .sitemap-col:last-child {
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .sitemap-mobile .sitemap-heading {
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0;
      padding: 16px 2px;
    }

    .sitemap-mobile .sitemap-heading::after {
      content: '';
      width: 8px;
      height: 8px;
      flex-shrink: 0;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg);
      transition: transform var(--ff-transition);
    }

    .sitemap-mobile .sitemap-col[open] .sitemap-heading::after {
      transform: rotate(-135deg);
    }

    .sitemap-mobile .sitemap-col ul {
      gap: 14px;
      padding: 2px 2px 20px;
    }
  }

  .bottom-bar {
    padding: 20px var(--ff-gutter);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .copyright {
    font-size: var(--ff-size-micro);
    color: var(--ff-on-navy-muted);
  }

  .social {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .social-link {
    display: flex;
    color: var(--ff-on-navy-muted);
    transition: color var(--ff-transition);
  }

  .social-link:hover {
    color: var(--ff-on-navy);
  }
</style>
