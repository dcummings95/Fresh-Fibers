---
interface Props {
  name: string;
  when: string;
  rating: number;
  text: string;
  avatarColor?: string;
}

const { name, when, rating, text, avatarColor = 'var(--ff-navy-cta)' } = Astro.props;
const initial = name.trim().charAt(0).toUpperCase();
---

<div class="review-card bleed-sm">
  <div class="head">
    <div class="avatar" style={{ background: avatarColor }}>{initial}</div>
    <div class="who">
      <div class="name">{name}</div>
      <div class="when">{when}</div>
    </div>
    <svg width="18" height="18" viewBox="0 0 48 48" aria-label="Posted on Google">
      <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
      <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
      <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
      <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
    </svg>
  </div>
  <div class="stars" aria-label={`${rating} out of 5 stars`}>{'★'.repeat(rating)}</div>
  <p>{text}</p>
</div>

<style>
  .review-card {
    background: var(--ff-surface);
    border-radius: var(--ff-radius-inner);
    box-shadow: var(--ff-shadow-card);
    padding: 24px;
  }

  @media (max-width: 640px) {
    .review-card {
      padding: 20px;
    }
  }

  .head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--ff-on-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--ff-weight-bold);
    font-size: var(--ff-size-body);
    flex-shrink: 0;
  }

  .who {
    flex: 1;
  }

  .name {
    font-weight: var(--ff-weight-semibold);
    color: var(--ff-text);
    font-size: var(--ff-size-body-sm);
  }

  .when {
    font-size: var(--ff-size-micro);
    color: var(--ff-text-muted);
  }

  .stars {
    color: #fbbc04;
    font-size: var(--ff-size-body-sm);
    letter-spacing: 2px;
    margin-bottom: 10px;
  }

  p {
    font-size: var(--ff-size-body-sm);
    line-height: 1.6;
    color: var(--ff-text-body);
    margin: 0;
  }
</style>
