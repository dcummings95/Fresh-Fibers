---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  theme?: 'light' | 'onNavy';
}

const { items, theme = 'light' } = Astro.props;
---

<nav class:list={['breadcrumb', { 'breadcrumb--on-navy': theme === 'onNavy' }]} aria-label="Breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {item.href ? <a href={item.href}>{item.label}</a> : <span class="current">{item.label}</span>}
        {i < items.length - 1 && <span class="sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb {
    margin: 32px 0 0;
  }

  ol {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: var(--ff-size-caption);
    color: var(--ff-text-breadcrumb);
  }

  li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  a {
    color: var(--ff-text-breadcrumb);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .current {
    color: var(--ff-navy);
    font-weight: var(--ff-weight-semibold);
  }

  .sep {
    color: #a9bdd2;
  }

  .breadcrumb--on-navy ol {
    color: var(--ff-on-navy-muted);
  }

  .breadcrumb--on-navy a {
    color: var(--ff-on-navy-muted);
  }

  .breadcrumb--on-navy .current {
    color: var(--ff-on-navy);
  }

  .breadcrumb--on-navy .sep {
    color: var(--ff-on-navy-muted);
    opacity: 0.6;
  }
</style>
