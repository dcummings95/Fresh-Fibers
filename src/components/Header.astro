---
import { Image } from 'astro:assets';
import site from '../content/site.json';
import logo from '../assets/images/logo.png';
import { services } from '../lib/services';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

interface NavItem {
  href: string;
  label: string;
  dropdown?: { href: string; label: string }[];
  viewAllLabel?: string;
}

const navItems: NavItem[] = [
  {
    href: '/services',
    label: 'Services',
    dropdown: services.map((s) => ({ href: `/services/${s.route}`, label: s.navLabel })),
    viewAllLabel: 'All services',
  },
  { href: '/pricing', label: 'Pricing' },
  { href: '/areas', label: 'Service Areas' },
  { href: '/about', label: 'About' },
  { href: '/reviews', label: 'Reviews' },
];

function isActive(href: string, path: string) {
  if (href === '/services' || href === '/areas') {
    return path === href || path.startsWith(`${href}/`);
  }
  return path === href;
}
---

<header class="site-header">
  <nav class="pill-nav" aria-label="Primary">
    <a href="/" class="logo">
      <Image src={logo} width={64} height={64} alt={`${site.name} logo`} />
      <span class="brand">{site.name}</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav-links"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span class="hamburger" aria-hidden="true">
        <span class="line"></span>
        <span class="line"></span>
        <span class="line"></span>
      </span>
    </button>

    <div class="nav-links" id="primary-nav-links" data-nav-links>
      {navItems.map((item, index) =>
        item.dropdown ? (
          <div class="nav-item">
            <a href={item.href} class:list={{ active: isActive(item.href, currentPath) }}>
              {item.label}
              <svg class="nav-chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path
                  d="M2.5 4.5L6 8l3.5-3.5"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
            <button
              type="button"
              class="dropdown-toggle"
              aria-expanded="false"
              aria-controls={`nav-dropdown-${index}`}
              aria-label={`Show ${item.label} submenu`}
              data-dropdown-toggle
            >
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path
                  d="M2.5 4.5L6 8l3.5-3.5"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <div class="dropdown" id={`nav-dropdown-${index}`}>
              <div class="dropdown-inner">
                {item.dropdown.map((sub) => (
                  <a href={sub.href} class:list={{ active: currentPath === sub.href }}>
                    {sub.label}
                  </a>
                ))}
                <a href={item.href} class="dropdown-all">
                  {item.viewAllLabel} <span class="arrow">→</span>
                </a>
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} class:list={{ active: isActive(item.href, currentPath) }}>
            {item.label}
          </a>
        )
      )}
      <a href={`tel:${site.phoneTel}`} class="phone">{site.phone}</a>
      <a href="/estimate" class="btn btn-primary btn-pill">Free estimate</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const links = document.querySelector('[data-nav-links]');

  function collapseSubmenus() {
    document.querySelectorAll('.nav-item.expanded').forEach((item) => {
      item.classList.remove('expanded');
      item.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', 'false');
    });
  }

  if (toggle && links) {
    toggle.addEventListener('click', () => {
      const open = links.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
      if (!open) collapseSubmenus();
    });

    links.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        links.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        collapseSubmenus();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && links.classList.contains('open')) {
        links.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        collapseSubmenus();
        (toggle as HTMLElement).focus();
      }
    });
  }

  // On mobile, the nav-item's own link/chevron toggles its submenu open
  // instead of relying on hover, which doesn't exist on touch screens.
  document.querySelectorAll('[data-dropdown-toggle]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const item = btn.closest('.nav-item');
      if (!item) return;
      const expanded = item.classList.toggle('expanded');
      btn.setAttribute('aria-expanded', String(expanded));
    });
  });

  // On touch devices without hover, the first tap on a dropdown trigger
  // reveals the submenu instead of navigating straight through.
  document.querySelectorAll('.nav-item').forEach((item) => {
    const trigger = item.querySelector<HTMLAnchorElement>(':scope > a');
    if (!trigger) return;

    trigger.addEventListener('click', (e) => {
      const isTouchDesktopNav = window.matchMedia('(hover: none) and (min-width: 1121px)').matches;
      if (!isTouchDesktopNav) return;

      if (!item.classList.contains('tap-open')) {
        e.preventDefault();
        document.querySelectorAll('.nav-item.tap-open').forEach((other) => {
          if (other !== item) other.classList.remove('tap-open');
        });
        item.classList.add('tap-open');
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('.nav-item')) return;
    document.querySelectorAll('.nav-item.tap-open').forEach((item) => item.classList.remove('tap-open'));
  });
</script>

<style>
  /* Spans the page on its own — it is a direct child of .header-sticky,
     which is a full-width flex item of body. It must NOT break out with
     `width: 100vw`: 100vw includes the classic scrollbar's width, so on
     any desktop browser that reserves one the header ends up ~8px wider
     than the page and pushes a horizontal scrollbar onto every route.
     .pill-nav below re-applies the .container max-width/gutter. */
  .site-header {
    background: var(--ff-surface);
    box-shadow: var(--ff-shadow-card);
  }

  .pill-nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--ff-container);
    margin: 0 auto;
    padding: 24px var(--ff-gutter);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 15px;
    flex-shrink: 0;
    white-space: nowrap;
    text-decoration: none;
  }

  .logo img {
    width: 64px;
    height: 64px;
    object-fit: contain;
  }

  .brand {
    font-family: var(--ff-font-display);
    font-weight: var(--ff-weight-semibold);
    font-size: 27px;
    color: var(--ff-navy);
    letter-spacing: var(--ff-tracking-tight);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 17px;
    color: var(--ff-nav-text);
    font-weight: var(--ff-weight-medium);
    white-space: nowrap;
    margin-left: 40px;
  }

  .nav-links a {
    color: var(--ff-nav-text);
    text-decoration: none;
  }

  .nav-links a.active {
    color: var(--ff-navy);
    font-weight: var(--ff-weight-bold);
  }

  .nav-links a.phone {
    color: var(--ff-navy);
    font-weight: var(--ff-weight-bold);
  }

  .nav-links a.btn {
    color: var(--ff-on-navy);
  }

  .nav-links > a:not(.phone):not(.btn),
  .nav-item > a {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 100%;
  }

  @media (min-width: 1121px) {
    .nav-links > a:not(.phone):not(.btn),
    .nav-item > a {
      padding-bottom: 3px;
    }
  }

  .nav-links > a:not(.phone):not(.btn)::after,
  .nav-item > a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 2px;
    border-radius: 1px;
    background: var(--ff-navy);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--ff-transition);
  }

  .nav-links > a:not(.phone):not(.btn):focus-visible::after,
  .nav-links > a:not(.phone):not(.btn).active::after,
  .nav-item:focus-within > a::after,
  .nav-item > a.active::after {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .nav-links > a:not(.phone):not(.btn):hover::after,
    .nav-item:hover > a::after {
      transform: scaleX(1);
    }
  }

  .nav-item {
    position: relative;
  }

  .nav-chevron {
    display: none;
  }

  @media (min-width: 1121px) {
    .nav-chevron {
      display: inline-flex;
      margin-left: 5px;
      color: var(--ff-text-muted);
      transition: transform var(--ff-transition);
    }

    .nav-item > a.active .nav-chevron {
      color: var(--ff-navy);
    }

    .nav-item:focus-within > a .nav-chevron,
    .nav-item.tap-open > a .nav-chevron {
      transform: rotate(180deg);
    }

    @media (hover: hover) {
      .nav-item:hover > a .nav-chevron {
        transform: rotate(180deg);
      }
    }
  }

  /*
   * The panel is offset from the trigger with padding rather than a `top` gap,
   * so the hover target stays contiguous: the pointer never crosses dead space
   * on its way down to an option. The side padding widens that corridor for
   * diagonal travel toward the outer items.
   */
  .dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    /* border-box: 210px of panel + 28px of corridor either side */
    min-width: 266px;
    padding: 8px 28px 12px;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -6px);
    transition: opacity var(--ff-transition), transform var(--ff-transition), visibility var(--ff-transition);
    z-index: 30;
  }

  .dropdown-inner {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--ff-surface);
    border-radius: var(--ff-radius-card);
    box-shadow: var(--ff-shadow-hover);
    padding: 10px;
  }

  @media (min-width: 1121px) {
    .nav-item:focus-within .dropdown,
    .nav-item.tap-open .dropdown {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
    }

    @media (hover: hover) {
      .nav-item:hover .dropdown {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, 0);
      }
    }
  }

  .dropdown a {
    padding: 9px 14px;
    border-radius: var(--ff-radius-btn);
    font-weight: var(--ff-weight-medium);
  }

  .dropdown a:focus-visible {
    background: var(--ff-band-blue);
  }

  @media (hover: hover) {
    .dropdown a:hover {
      background: var(--ff-band-blue);
    }
  }

  .dropdown-all {
    margin-top: 4px;
    padding-top: 12px !important;
    border-top: 1px solid var(--ff-border-soft);
    color: var(--ff-navy-cta) !important;
    font-weight: var(--ff-weight-semibold) !important;
  }

  .dropdown-all .arrow {
    color: var(--ff-azure);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    color: var(--ff-navy);
    border-radius: 50%;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-toggle:active {
    background: transparent;
  }

  .hamburger {
    position: relative;
    width: 20px;
    height: 15px;
  }

  .hamburger .line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 0.25s ease, opacity 0.2s ease, top 0.25s ease;
  }

  .hamburger .line:nth-child(1) {
    top: 0;
  }

  .hamburger .line:nth-child(2) {
    top: 6.5px;
  }

  .hamburger .line:nth-child(3) {
    top: 13px;
  }

  .nav-toggle[aria-expanded='true'] .line:nth-child(1) {
    top: 6.5px;
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .nav-toggle[aria-expanded='true'] .line:nth-child(3) {
    top: 6.5px;
    transform: rotate(-45deg);
  }

  .dropdown-toggle {
    display: none;
  }

  @media (max-width: 1120px) {
    .pill-nav {
      padding: 18px var(--ff-gutter);
    }

    .logo img {
      width: 46px;
      height: 46px;
    }

    .brand {
      font-size: 21px;
    }

    .nav-toggle {
      width: 46px;
      height: 46px;
      display: inline-flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      margin-left: 0;
      background: var(--ff-surface);
      border-radius: 0 0 var(--ff-radius-card) var(--ff-radius-card);
      box-shadow: var(--ff-shadow-hover);
      padding: 10px 16px 18px;
      font-size: 17px;
      z-index: 20;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links a {
      padding: 13px 14px;
      border-radius: var(--ff-radius-btn);
    }

    .nav-links a.btn {
      justify-content: center;
      margin-top: 10px;
      padding: 15px 14px;
    }

    .nav-links a.phone {
      padding: 13px 14px;
    }

    .nav-item {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .nav-item > a {
      grid-column: 1;
    }

    .dropdown-toggle {
      display: inline-flex;
      grid-column: 2;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border: none;
      background: transparent;
      color: var(--ff-nav-text-muted);
      cursor: pointer;
      transition: transform var(--ff-transition), color var(--ff-transition);
      -webkit-tap-highlight-color: transparent;
    }

    .dropdown-toggle:active {
      background: transparent;
    }

    .nav-item.expanded .dropdown-toggle {
      transform: rotate(180deg);
      color: var(--ff-navy);
    }

    .dropdown {
      grid-column: 1 / -1;
      position: static;
      padding: 0;
      opacity: 1;
      visibility: visible;
      transform: none;
      min-width: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .nav-item.expanded .dropdown {
      max-height: 600px;
    }

    .dropdown-inner {
      display: flex;
      flex-direction: column;
      gap: 2px;
      background: transparent;
      border-radius: 0;
      box-shadow: none;
      padding: 4px 0 6px 14px;
      min-height: 0;
      overflow: hidden;
    }

    .dropdown a {
      color: var(--ff-nav-text-muted);
      font-size: 16px;
      padding: 10px 12px;
    }

    .dropdown-all {
      border-top: none;
      padding-top: 8px !important;
    }
  }
</style>
