---
import { Image } from 'astro:assets';
import site from '../content/site.json';
import logo from '../assets/images/logo.png';
import { services } from '../lib/services';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

interface NavItem {
  href: string;
  label: string;
  dropdown?: { href: string; label: string }[];
  viewAllLabel?: string;
}

const navItems: NavItem[] = [
  {
    href: '/services',
    label: 'Services',
    dropdown: services.map((s) => ({ href: `/services/${s.route}`, label: s.navLabel })),
    viewAllLabel: 'All services',
  },
  {
    href: '/areas',
    label: 'Areas',
    dropdown: [
      { href: '/areas/winona', label: 'Winona, MN' },
      { href: '/areas/la-crosse', label: 'La Crosse, WI' },
    ],
    viewAllLabel: 'All areas',
  },
  { href: '/work', label: 'Before & After' },
  { href: '/about', label: 'About' },
  { href: '/reviews', label: 'Reviews' },
];

function isActive(href: string, path: string) {
  if (href === '/services' || href === '/areas') {
    return path === href || path.startsWith(`${href}/`);
  }
  return path === href;
}
---

<header class="site-header">
  <nav class="pill-nav" aria-label="Primary">
    <a href="/" class="logo">
      <Image src={logo} width={54} height={54} alt={`${site.name} logo`} />
      <span class="brand">{site.name}</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav-links"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>

    <div class="nav-links" id="primary-nav-links" data-nav-links>
      {navItems.map((item) =>
        item.dropdown ? (
          <div class="nav-item">
            <a href={item.href} class:list={{ active: isActive(item.href, currentPath) }}>
              {item.label}
            </a>
            <div class="dropdown">
              {item.dropdown.map((sub) => (
                <a href={sub.href} class:list={{ active: currentPath === sub.href }}>
                  {sub.label}
                </a>
              ))}
              <a href={item.href} class="dropdown-all">
                {item.viewAllLabel} <span class="arrow">→</span>
              </a>
            </div>
          </div>
        ) : (
          <a href={item.href} class:list={{ active: isActive(item.href, currentPath) }}>
            {item.label}
          </a>
        )
      )}
      <a href={`tel:${site.phoneTel}`} class="phone">{site.phone}</a>
      <a href="/book" class="btn btn-primary btn-pill">Book online</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const links = document.querySelector('[data-nav-links]');

  if (toggle && links) {
    toggle.addEventListener('click', () => {
      const open = links.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    links.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        links.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && links.classList.contains('open')) {
        links.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        (toggle as HTMLElement).focus();
      }
    });
  }

  // On touch devices without hover, the first tap on a dropdown trigger
  // reveals the submenu instead of navigating straight through.
  document.querySelectorAll('.nav-item').forEach((item) => {
    const trigger = item.querySelector<HTMLAnchorElement>(':scope > a');
    if (!trigger) return;

    trigger.addEventListener('click', (e) => {
      const isTouchDesktopNav = window.matchMedia('(hover: none) and (min-width: 941px)').matches;
      if (!isTouchDesktopNav) return;

      if (!item.classList.contains('tap-open')) {
        e.preventDefault();
        document.querySelectorAll('.nav-item.tap-open').forEach((other) => {
          if (other !== item) other.classList.remove('tap-open');
        });
        item.classList.add('tap-open');
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('.nav-item')) return;
    document.querySelectorAll('.nav-item.tap-open').forEach((item) => item.classList.remove('tap-open'));
  });
</script>

<style>
  .site-header {
    padding: 20px 0 0;
  }

  .pill-nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 15px 13px 22px;
    background: var(--ff-surface);
    border: 1px solid var(--ff-border);
    border-radius: var(--ff-radius-pill);
    box-shadow: var(--ff-shadow-nav);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 13px;
    flex-shrink: 0;
    white-space: nowrap;
    text-decoration: none;
  }

  .logo img {
    width: 54px;
    height: 54px;
    object-fit: contain;
  }

  .brand {
    font-family: var(--ff-font-display);
    font-weight: var(--ff-weight-bold);
    font-size: 21px;
    color: var(--ff-navy);
    letter-spacing: var(--ff-tracking-tight);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: var(--ff-size-caption);
    color: #4a4436;
    font-weight: var(--ff-weight-medium);
    white-space: nowrap;
    margin-left: 28px;
  }

  .nav-links a {
    color: #4a4436;
    text-decoration: none;
  }

  .nav-links a.active {
    color: var(--ff-navy);
    font-weight: var(--ff-weight-bold);
  }

  .nav-links a.phone {
    color: var(--ff-navy);
    font-weight: var(--ff-weight-bold);
  }

  .nav-links > a:not(.phone):not(.btn),
  .nav-item > a {
    position: relative;
    padding-bottom: 3px;
  }

  .nav-links > a:not(.phone):not(.btn)::after,
  .nav-item > a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 2px;
    border-radius: 1px;
    background: var(--ff-navy);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--ff-transition);
  }

  .nav-links > a:not(.phone):not(.btn):hover::after,
  .nav-links > a:not(.phone):not(.btn):focus-visible::after,
  .nav-links > a:not(.phone):not(.btn).active::after,
  .nav-item:hover > a::after,
  .nav-item:focus-within > a::after,
  .nav-item > a.active::after {
    transform: scaleX(1);
  }

  .nav-item {
    position: relative;
  }

  .dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    min-width: 210px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--ff-surface);
    border: 1px solid var(--ff-border);
    border-radius: var(--ff-radius-card);
    box-shadow: var(--ff-shadow-hover);
    padding: 10px;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -6px);
    transition: opacity var(--ff-transition), transform var(--ff-transition), visibility var(--ff-transition);
    z-index: 30;
  }

  .nav-item:hover .dropdown,
  .nav-item:focus-within .dropdown,
  .nav-item.tap-open .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .dropdown a {
    padding: 9px 14px;
    border-radius: 8px;
    font-weight: var(--ff-weight-medium);
  }

  .dropdown a:hover,
  .dropdown a:focus-visible {
    background: var(--ff-fill-blue);
  }

  .dropdown-all {
    margin-top: 4px;
    padding-top: 12px !important;
    border-top: 1px solid var(--ff-border-soft);
    color: var(--ff-navy-cta) !important;
    font-weight: var(--ff-weight-semibold) !important;
  }

  .dropdown-all .arrow {
    color: var(--ff-azure);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    color: var(--ff-navy);
    border-radius: 50%;
    cursor: pointer;
  }

  @media (max-width: 940px) {
    .nav-toggle {
      display: inline-flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      left: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      margin-left: 0;
      background: var(--ff-surface);
      border: 1px solid var(--ff-border);
      border-radius: var(--ff-radius-card);
      box-shadow: var(--ff-shadow-hover);
      padding: 14px;
      z-index: 20;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links a {
      padding: 10px 12px;
      border-radius: 8px;
    }

    .nav-links a.btn {
      justify-content: center;
      margin-top: 6px;
    }

    .nav-item {
      display: flex;
      flex-direction: column;
    }

    .dropdown {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      background: transparent;
      border: none;
      box-shadow: none;
      padding: 0 0 6px 14px;
      min-width: 0;
    }

    .dropdown a {
      color: #6b6455;
      font-size: 14px;
      padding: 8px 12px;
    }

    .dropdown-all {
      border-top: none;
      padding-top: 8px !important;
    }
  }
</style>
