---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../content/site.json';
import { buildLocalBusinessSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  heroFlush?: boolean;
  noindex?: boolean;
}

const { title, description, structuredData, heroFlush = false, noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, site.url).toString();
const localBusinessSchema = buildLocalBusinessSchema();
const extraSchemas = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#dfeaf3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#dfeaf3" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {extraSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4RWZLQL22K"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4RWZLQL22K');
    </script>

    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '2123000092433560');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=2123000092433560&ev=PageView&noscript=1"
    /></noscript>
  </head>
  <body>
    <div class="chrome-tint chrome-tint-bottom" aria-hidden="true"></div>

    <div class:list={['top-band', { 'top-band--flush': heroFlush }]}>
      <div class="header-sticky">
        <div class="container">
          <Header currentPath={Astro.url.pathname} />
        </div>
      </div>
      <div class:list={['hero-slot', { 'hero-slot--navy': heroFlush }]}>
        <div class="container">
          <slot name="hero" />
        </div>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  .top-band {
    background: var(--ff-band-blue);
    padding-bottom: 56px;
    flex-shrink: 0;
  }

  /* Bold navy heroes paint their own full-bleed background right up to
     the header, so the shared band's own color/padding would just show
     as a stray strip behind and below it. */
  .top-band--flush {
    background: transparent;
    padding-bottom: 0;
  }

  /* Full-bleed navy backdrop for bold page heroes, breaking out of the
     nested .container the same way .site-header does. position:relative
     here is what lets a hero's own absolutely-positioned photo (nested
     two levels down, inside .container) bleed to the true viewport
     edge — absolute positioning skips the intervening static .container
     and resolves against this element instead. */
  .hero-slot--navy {
    position: relative;
    background: var(--ff-navy);
    width: 100vw;
    margin-left: calc(50% - 50vw);
    /* Establishes a new block-formatting context so a hero-content
       child's top margin (e.g. Breadcrumb's) can't collapse through
       this element and .container to push the whole navy band down,
       leaving a gap that exposes the page background behind it. */
    display: flow-root;
  }

  /* Real, visible sticky chrome (not a contentless decoy) for Safari's
     iOS 26 toolbar-tint sampler to key off — see chrome-tint comment
     below for why a decoy alone proved unreliable on real hardware. */
  .header-sticky {
    position: sticky;
    top: 0;
    z-index: 15;
    background: var(--ff-band-blue);
    padding-top: env(safe-area-inset-top);
  }

  /* Grows to absorb leftover space so the footer lands on the real
     bottom of the viewport on short pages, instead of floating above
     a gap. min-height: 0 keeps it from refusing to shrink below its
     content size, which flex items default to and which would defeat
     the min-height: 100dvh on body for pages taller than the viewport. */
  main {
    flex: 1 0 auto;
    min-height: 0;
  }

  /* iOS 26 Safari tints its toolbar chrome by sampling the
     background-color of fixed/sticky elements at the viewport edges
     (theme-color is no longer read at all). The footer has no
     always-visible real element to anchor to at the bottom edge, so
     this decoy still carries no content — it only exists to give
     Safari a color to sample there. The top edge instead uses the
     real sticky header (.header-sticky above), since reports suggest
     Safari's sampling of contentless decoy elements is unreliable
     compared to genuine visible chrome. */
  .chrome-tint {
    position: fixed;
    left: 0;
    right: 0;
    pointer-events: none;
    z-index: 10;
  }

  /* min-height floor: on devices with no inset (e.g. iPhone SE, no
     home indicator/notch), env(safe-area-inset-*) resolves to 0 and
     the tint collapses below Safari's sampling threshold, falling
     through to body's cream background instead of the intended
     band color. The floor keeps it sampleable everywhere. */
  .chrome-tint-bottom {
    bottom: 0;
    height: max(env(safe-area-inset-bottom), 8px);
    background: var(--ff-navy-deep);
  }
</style>
