{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-05",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "fresh-fibers",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": false,
	"routes": [
		{ "pattern": "getfreshfibers.com", "custom_domain": true }
	],
	"env": {
		"dev": {
			"name": "fresh-fibers-dev",
			"workers_dev": false,
			"routes": [
				{ "pattern": "dev.getfreshfibers.com", "custom_domain": true }
			]
		}
	}
}