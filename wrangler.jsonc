{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-05",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "fresh-fibers",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"send_email": [
		{ "name": "EMAIL", "remote": true }
	],
	"ratelimits": [
		{
			"name": "QUOTE_FORM_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 3, "period": 60 }
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fresh-fibers-db",
			"database_id": "5794a98d-a655-4070-8060-23efd4f0758b"
		}
	],
	"workers_dev": false,
	"routes": [
		{ "pattern": "getfreshfibers.com", "custom_domain": true }
	],
	"env": {
		"dev": {
			"name": "fresh-fibers-dev",
			"workers_dev": false,
			"routes": [
				{ "pattern": "dev.getfreshfibers.com", "custom_domain": true }
			],
			"send_email": [
				{ "name": "EMAIL" }
			],
			"ratelimits": [
				{
					"name": "QUOTE_FORM_RATE_LIMITER",
					"namespace_id": "1002",
					"simple": { "limit": 3, "period": 60 }
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "fresh-fibers-db-dev",
					"database_id": "0ee50a8e-60fa-4d5c-a86e-be247d83e597"
				}
			]
		}
	}
}